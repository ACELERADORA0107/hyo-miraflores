# Copia este archivo a .env.local (NO subir .env.local al repositorio) y completa
# los valores con la config que te da Firebase Console > Configuracion del proyecto > Tus apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
